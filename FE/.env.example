# Copy to .env.local and fill in real values:
#   cp .env.example .env.local

NEXT_PUBLIC_API_BASE_URL=https://eventtrackerapi.example.com/v1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Optional Cloud Map ID for Advanced Markers. Leave unset to use Google's
# DEMO_MAP_ID. Do not set this to "roadmap" (that is a map type, not a Map ID).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
